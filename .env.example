# ─── Site ────────────────────────────────────────────────────────────────────
# The production URL of the site (no trailing slash)
SITE_URL=https://yourclientsite.com

# ─── Sanity ──────────────────────────────────────────────────────────────────
# Found in sanity.io/manage under your project
PUBLIC_SANITY_PROJECT_ID=your_project_id
PUBLIC_SANITY_DATASET=production

# The URL where Sanity Studio is deployed (for stega / visual editing)
# Format: https://your-project-name.sanity.studio
SANITY_STUDIO_URL=https://your-studio.sanity.studio

# API token — create a "Viewer" token in sanity.io/manage
# Needed for server-side fetching of draft content (visual editing)
SANITY_API_READ_TOKEN=your_read_token_here

# ─── Forms → n8n ─────────────────────────────────────────────────────────────
# The n8n webhook URL for this client's contact form submissions
# Each client gets their own webhook so leads route to the right CRM
N8N_CONTACT_WEBHOOK_URL=https://flow.ascendaimarketing.cloud/webhook/your-webhook-id

# ─── Optional: CRM Direct ────────────────────────────────────────────────────
# If the client uses GoHighLevel, HubSpot, etc. and you want a direct fallback
# GHL_API_KEY=
# HUBSPOT_PORTAL_ID=
