# ─── Site ────────────────────────────────────────────────────────────────────
# The production URL of the site (no trailing slash). Used for canonical URLs,
# the sitemap and social share links.
SITE_URL=https://www.uriahchildcare.com

# ─── Sanity ──────────────────────────────────────────────────────────────────
# Found in sanity.io/manage under your project
PUBLIC_SANITY_PROJECT_ID=your_project_id
PUBLIC_SANITY_DATASET=production

# API token — create a "Viewer" token in sanity.io/manage → API → Tokens.
# Server-side only. Required for visual editing / draft previews.
SANITY_API_READ_TOKEN=your_read_token_here

# Optional — only if you ALSO deploy the Studio separately (npm run sanity:deploy):
# SANITY_STUDIO_URL=https://your-studio.sanity.studio      # where overlays link to
# SANITY_STUDIO_PREVIEW_ORIGIN=https://yourclientsite.com   # site the hosted Studio previews
# SANITY_STUDIO_PROJECT_ID=your_project_id                  # the hosted Studio reads these names
# SANITY_STUDIO_DATASET=production

# ─── Forms → n8n ─────────────────────────────────────────────────────────────
# The n8n webhook URL for this client's contact form submissions
# Each client gets their own webhook so leads route to the right CRM
N8N_CONTACT_WEBHOOK_URL=https://flow.ascendaimarketing.cloud/webhook/your-webhook-id

# ─── Local seed preview only (npm run dev:seed sets these) ──────────────────
# Never set these on Netlify. They point the site at seed/mock-api.mjs instead of Sanity.
# SANITY_API_HOST=http://localhost:9999
# PUBLIC_SANITY_IMAGE_BASE_URL=http://localhost:9999
