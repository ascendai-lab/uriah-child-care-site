          "_key": "k000t4",
          "_type": "span",
          "marks": [],
          "text": "Drop off from 6 am"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "k000t5",
      "_type": "block",
      "children": [
        {
          "_key": "k000t6",
          "_type": "span",
          "marks": [],
          "text": "Many Vineland parents start work at 6 or 7 in the morning. We open at "
        },
        {
          "_key": "k000t7",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "6 am, Monday to Saturday"
        },
        {
          "_key": "k000t8",
          "_type": "span",
          "marks": [],
          "text": ", so you can drop off on the way and still get to work on time."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "k000t9",
      "_type": "block",
      "children": [
        {
          "_key": "k000ta",
          "_type": "span",
          "marks": [],
          "text": "A gentle morning for your child"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "k000tb",
      "_type": "block",
      "children": [
        {
          "_key": "k000tc",
          "_type": "span",
          "marks": [],
          "text": "Early arrivals get breakfast and a quiet start: books, puzzles and free play while the center wakes up. Toddlers and younger children join circle time and the day's activities, and school-age kids can start the day here with "
        },
        {
          "_key": "k000te",
          "_type": "span",
          "marks": [
            "k000td"
          ],
          "text": "before school care"
        },
        {
          "_key": "k000tf",
          "_type": "span",
          "marks": [],
          "text": "."
        }
      ],
      "markDefs": [
        {
          "_key": "k000td",
          "_type": "link",
          "internal": {
            "_ref": "service-before-school",
            "_type": "reference"
          },
          "linkType": "internal"
        }
      ],
      "style": "normal"
    },
    {
      "_key": "k000tg",
      "_type": "block",
      "children": [
        {
          "_key": "k000th",
          "_type": "span",
          "marks": [],
          "text": "Breakfast is included"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "k000ti",
      "_type": "block",
      "children": [
        {
          "_key": "k000tj",
          "_type": "span",
          "marks": [],
          "text": "You don't have to feed everyone before a 6 am shift. Breakfast is served from 7:30 to 9 am through the USDA Child and Adult Care Food Program (CACFP). On a typical morning that's whole-grain cereal or a muffin, fresh fruit like cantaloupe, peaches or honeydew, and milk. The menu changes every month."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "k000tk",
      "_type": "block",
      "children": [
        {
          "_key": "k000tl",
          "_type": "span",
          "marks": [],
          "text": "Who uses early morning care"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "k000tm",
      "_type": "block",
      "children": [
        {
          "_key": "k000tn",
          "_type": "span",
          "marks": [],
          "text": "Nurses and hospital staff starting at 7 am, warehouse and plant workers on first shift, and anyone who has to be at work before schools and most daycares open. School-age kids can stay with us until it's time for school, and school buses can pick up at the center."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "k000to",
      "_type": "block",
      "children": [
        {
          "_key": "k000tp",
          "_type": "span",
          "marks": [],
          "text": "Fast check-in"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "k000tq",
      "_type": "block",
      "children": [
        {
          "_key": "k000tr",
          "_type": "span",
          "marks": [],
          "text": "Check your child in with Procare and you're on your way."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
