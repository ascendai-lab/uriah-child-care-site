    {
      "_key": "k000yi",
      "_type": "block",
      "children": [
        {
          "_key": "k000yj",
          "_type": "span",
          "marks": [],
          "text": "Whatever hours your child is here, meals come at set times through the USDA food program (CACFP): breakfast from 7:30 to 9 am, lunch at 12 noon, a snack at 3 pm, dinner at 6 pm and an evening snack at 9 pm. Tell us about allergies when you enroll."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
