      "_type": "block",
      "children": [
        {
          "_key": "k000e2",
          "_type": "span",
          "marks": [],
          "text": "Getting to and from school"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "k000e3",
      "_type": "block",
      "children": [
        {
          "_key": "k000e4",
          "_type": "span",
          "marks": [],
          "text": "We don't drive children to or from school, but school buses can pick up and drop off at our center. Ask your school district about a bus stop at 30 W Chestnut Ave. Vineland Public Schools elementary schools such as Gloria M. Sabater Elementary School are close by. Parents can always drop off and pick up at the center too."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
