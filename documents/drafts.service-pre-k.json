    {
      "_key": "k000lm",
      "_type": "block",
      "children": [
        {
          "_key": "k000ln",
          "_type": "span",
          "marks": [],
          "text": "Pre-K is led by Ms. Paulette, who has cared for local children since 2005, with our director, Tameca Burke, who has about five years of experience in child care. Ms. Paulette is certified in pediatric First Aid and CPR/AED, and every staff member must have CPR and first aid training before we hire them."
        }
      ],
      "markDefs": [],
      "style": "normal"
