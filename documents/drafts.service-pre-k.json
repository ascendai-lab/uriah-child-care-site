          "_key": "k000lj",
          "_type": "span",
          "marks": [],
          "text": "Our pre-K runs inside a full child care day. Your child can arrive at 6 am and stay into the evening, or come on weekends, so you don't have to piece together care around a short school day."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
