      "_type": "block",
      "children": [
        {
          "_key": "k000vh",
          "_type": "span",
          "marks": [],
          "text": "You check out with Procare, and we release children only to adults you have authorized in writing. A security camera watches the front entrance, and our building has a ramp and accessible parking, which helps when you're carrying a sleepy child."
        }
      ],
      "markDefs": [],
      "style": "normal"
