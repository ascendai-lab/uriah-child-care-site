            {
              "_key": "k000tm",
              "_type": "span",
              "marks": [],
              "text": "At Uriah Child Care, accessible from uriahchildcare.com, one of our main priorities is the privacy of our visitors. This Privacy Policy describes the information Uriah Child Care collects and records and how we use it."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "k000tn",
          "_type": "block",
          "children": [
            {
              "_key": "k000to",
              "_type": "span",
              "marks": [],
              "text": "If you have additional questions or need more information about our Privacy Policy, contact us at "
            },
            {
              "_key": "k000tq",
              "_type": "span",
              "marks": [
                "k000tp"
              ],
              "text": "hello@uriahchildcare.com"
            },
            {
              "_key": "k000tr",
