      "style": "h2"
    },
    {
      "_key": "k000r6",
      "_type": "block",
      "children": [
        {
          "_key": "k000r7",
          "_type": "span",
          "marks": [],
          "text": "Children have breakfast, lunch and snacks through the USDA food program (CACFP). We mix reading time with art, building, games and time with friends, so kids stay busy and keep their skills up before the new school year."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
