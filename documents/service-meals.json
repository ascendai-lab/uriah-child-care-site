        {
          "_key": "k000jw",
          "_type": "span",
          "marks": [],
          "text": "Who prepares our meals"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "k000jx",
      "_type": "block",
      "children": [
        {
          "_key": "k000jy",
          "_type": "span",
          "marks": [],
          "text": "Our meals are made by a licensed local food vendor and delivered following Vineland Health Department and New Jersey licensing rules. We have a Certified Food Protection Manager on staff, and we follow food safety rules for storing, holding and serving food at the right temperature. Weekly menus are posted for families. Because of these rules, breakfast can't be brought from home, and birthday treats need to be store-bought, labeled with their ingredients and okayed with us first."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "k000jz",
      "_type": "block",
      "children": [
        {
          "_key": "k000k0",
          "_type": "span",
          "marks": [],
          "text": "Allergies and special diets"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "k000k1",
      "_type": "block",
      "children": [
        {
          "_key": "k000k2",
          "_type": "span",
          "marks": [],
          "text": "If your child has a food allergy, a medical condition or a special diet, bring a note from your child's doctor and we will fill out an Allergy Action Plan together and keep it on file. We plan your child's meals around it, and staff can see it at every meal. Let us know before your child's first day, and tell us if anything changes."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "k000k3",
      "_type": "block",
      "children": [
        {
          "_key": "k000k4",
          "_type": "span",
          "marks": [],
          "text": "We encourage children to try new foods, but we never force them."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
