      "_type": "block",
      "children": [
        {
          "_key": "k000uh",
          "_type": "span",
          "marks": [],
          "text": "Pick up any time before we close at 11 pm. You check out with Procare, we release children only to adults you have authorized in writing, and a security camera watches the front entrance."
        }
      ],
      "markDefs": [],
      "style": "normal"
