---
import BaseLayout from '@layouts/BaseLayout.astro'
import PageBuilder from '@components/blocks/PageBuilder.astro'
import EmptyState from '@components/ui/EmptyState.astro'
import { loadQuery } from '@cms/lib/load'
import { homePageQuery, layoutQuery } from '@cms/queries'

const { draftMode } = Astro.locals
const [layout, page] = await Promise.all([loadQuery(draftMode, layoutQuery), loadQuery(draftMode, homePageQuery)])

// Reviews shown on the home page feed the ChildCare aggregateRating (first-party, visible reviews only).
const reviewBlock = page?.pageBuilder?.find((b) => b._type === 'testimonialsBlock')
const reviews = reviewBlock && 'items' in reviewBlock ? (reviewBlock.items ?? []) : []
---

<BaseLayout layout={layout} seo={page?.seo} isHome reviews={reviews}>
  {
    page?.pageBuilder?.length ? (
      <PageBuilder blocks={page.pageBuilder} document={page} layout={layout} />
    ) : (
      <EmptyState />
    )
  }
</BaseLayout>
