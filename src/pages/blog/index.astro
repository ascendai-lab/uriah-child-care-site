---
import BaseLayout from '@layouts/BaseLayout.astro'
import PostCard from '@components/cards/PostCard.astro'
import { loadQuery } from '@cms/lib/load'
import { blogIndexQuery, layoutQuery } from '@cms/queries'

const { draftMode } = Astro.locals
const [layout, posts] = await Promise.all([loadQuery(draftMode, layoutQuery), loadQuery(draftMode, blogIndexQuery)])
---

<BaseLayout layout={layout} title="Blog">
  <section class="section bg-muted">
    <div class="container">
      <header class="section-header"><h1 class="section-heading">Blog</h1></header>
      {posts.length ? (
        <div class="grid-cards" data-columns="3">{posts.map((post) => <PostCard post={post} />)}</div>
      ) : (
        <p class="section-intro" style="text-align:center">No posts yet.</p>
      )}
    </div>
  </section>
</BaseLayout>
