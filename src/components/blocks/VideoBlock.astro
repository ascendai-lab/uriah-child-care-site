---
import type { BlockOf } from '@cms/lib/types'
import { getEmbedUrl, getVideoFacade } from '@/lib/video'
import VideoFacade from '@components/ui/VideoFacade.astro'
import Section from '@components/ui/Section.astro'
import SectionHeader from '@components/ui/SectionHeader.astro'

interface Props {
  block: BlockOf<'videoBlock'>
  'data-sanity'?: string
}

const { block, 'data-sanity': dataSanity } = Astro.props
const embedUrl = getEmbedUrl(block.video?.url, Boolean(block.video?.autoplay))
const facade = getVideoFacade(block.video?.url, Boolean(block.video?.autoplay))
const videoTitle = block.video?.caption || block.heading || 'Video'
---

<Section anchorId={block.anchorId} background={block.background} data-sanity={dataSanity}>
  <SectionHeader heading={block.heading} intro={block.intro} />
  {
    embedUrl && (
      <figure class="video">
        <div class="video-frame">
          {facade ? (
            <VideoFacade facade={facade} title={videoTitle} />
          ) : (
            <iframe
              src={embedUrl}
              title={videoTitle}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          )}
        </div>
        {block.video?.caption && <figcaption>{block.video.caption}</figcaption>}
      </figure>
    )
  }
</Section>

<style>
  .video { max-width: 60rem; margin-inline: auto; }
  figcaption { margin-top: 0.75rem; text-align: center; font-size: 0.9rem; }
</style>
