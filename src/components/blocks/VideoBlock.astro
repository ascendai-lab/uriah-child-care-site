---
import type { BlockOf } from '@cms/lib/types'
import { getEmbedUrl } from '@/lib/video'
import Section from '@components/ui/Section.astro'
import SectionHeader from '@components/ui/SectionHeader.astro'

interface Props {
  block: BlockOf<'videoBlock'>
  'data-sanity'?: string
}

const { block, 'data-sanity': dataSanity } = Astro.props
const embedUrl = getEmbedUrl(block.video?.url, Boolean(block.video?.autoplay))
---

<Section anchorId={block.anchorId} background={block.background} data-sanity={dataSanity}>
  <SectionHeader heading={block.heading} intro={block.intro} />
  {
    embedUrl && (
      <figure class="video">
        <div class="video-frame">
          <iframe
            src={embedUrl}
            title={block.video?.caption || block.heading || 'Video'}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </div>
        {block.video?.caption && <figcaption>{block.video.caption}</figcaption>}
      </figure>
    )
  }
</Section>

<style>
  .video { max-width: 60rem; margin-inline: auto; }
  figcaption { margin-top: 0.75rem; text-align: center; font-size: 0.9rem; }
</style>
