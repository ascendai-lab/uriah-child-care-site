---
import { stegaClean } from '@sanity/client/stega'
import type { BlockOf } from '@cms/lib/types'
import Section from '@components/ui/Section.astro'
import SectionHeader from '@components/ui/SectionHeader.astro'
import PortableText from '@components/ui/PortableText'

interface Props {
  block: BlockOf<'textBlock'>
  'data-sanity'?: string
}

const { block, 'data-sanity': dataSanity } = Astro.props
const width = stegaClean(block.width) || 'narrow'
---

<Section anchorId={block.anchorId} background={block.background} data-sanity={dataSanity}>
  <div class:list={['text-block', `text-block--${width}`, block.heading && 'text-block--split']}>
    <SectionHeader heading={block.heading} />
    <PortableText value={block.body} />
  </div>
</Section>

<style>
  /* Left-aligned with the page grid, like the hero above it. */
  .text-block--narrow { max-width: 46rem; }
  .text-block--narrow:not(.text-block--split) { margin-inline: auto; }
  .text-block :global(.section-header) { text-align: left; margin-inline: 0; margin-bottom: 1.5rem; }
  /* Wide screens: heading on the left, text on the right, so a short block doesn't leave half the row empty. */
  @media (min-width: 1040px) {
    .text-block--narrow.text-block--split { max-width: none; display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr); gap: 4rem; align-items: start; }
    .text-block--split :global(.section-header) { margin-bottom: 0; }
  }
</style>
