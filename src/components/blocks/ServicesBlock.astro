---
import type { BlockOf } from '@cms/lib/types'
import Section from '@components/ui/Section.astro'
import SectionHeader from '@components/ui/SectionHeader.astro'
import ProgramCard from '@components/cards/ProgramCard.astro'
import { rowAccents } from '@lib/accents'

interface Props {
  block: BlockOf<'servicesBlock'>
  'data-sanity'?: string
}

const { block, 'data-sanity': dataSanity } = Astro.props
const items = (block.items ?? []).filter(Boolean)
const accents = rowAccents(items)
const cols = items.length >= 4 ? 4 : items.length === 2 ? 2 : 3
---

<Section anchorId={block.anchorId} background={block.background} data-sanity={dataSanity}>
  <SectionHeader heading={block.heading} intro={block.intro} align="center" />
  <div class={`grid-cards grid-cards--${cols}`}>
    {items.map((item, i) => <ProgramCard item={{ ...item, accent: accents[i] }} index={i} />)}
  </div>
</Section>
