---
import type { BlockOf } from '@cms/lib/types'
import Section from '@components/ui/Section.astro'
import SectionHeader from '@components/ui/SectionHeader.astro'
import SanityImage from '@components/ui/SanityImage.astro'

interface Props {
  block: BlockOf<'galleryBlock'>
  'data-sanity'?: string
}

const { block, 'data-sanity': dataSanity } = Astro.props
const images = (block.images ?? []).filter((img) => img?.asset)
---

<Section anchorId={block.anchorId} background={block.background} data-sanity={dataSanity}>
  <SectionHeader heading={block.heading} intro={block.intro} />
  {/* Mosaic: the first photo is large (2x2), the rest fill a fixed-height grid so no card has empty space. */}
  <ul class="gallery">
    {
      images.map((img, i) => (
        <li class:list={['gallery__item', i === 0 && 'gallery__item--feature']}>
          <figure>
            <SanityImage image={img} width={i === 0 ? 1000 : 600} aspectRatio={i === 0 ? 1 : 4 / 3} sizes={i === 0 ? '(min-width: 900px) 66vw, 100vw' : '(min-width: 900px) 33vw, 100vw'} />
            {img.caption && <figcaption>{img.caption}</figcaption>}
          </figure>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .gallery { list-style: none; display: grid; gap: 1rem; grid-template-columns: 1fr; }
  .gallery figure { position: relative; height: 100%; margin: 0; border-radius: var(--radius-xl); overflow: hidden; background: var(--surface-soft); }
  .gallery :global(img) { width: 100%; height: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform 700ms var(--ease-out); }
  .gallery figure:hover :global(img) { transform: scale(1.03); }
  .gallery figcaption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.94);
    color: var(--navy);
    font-size: 0.88rem;
    font-weight: 700;
  }
  @media (min-width: 640px) {
    .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 220px; }
    .gallery__item--feature { grid-column: span 2; grid-row: span 2; }
    .gallery :global(img) { aspect-ratio: auto; }
  }
  @media (min-width: 960px) {
    .gallery { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: 240px; }
  }
</style>
