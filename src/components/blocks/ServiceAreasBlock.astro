---
import type { BlockOf } from '@cms/lib/types'
import Section from '@components/ui/Section.astro'
import SectionHeader from '@components/ui/SectionHeader.astro'
import ProgramCard from '@components/cards/ProgramCard.astro'

interface Props {
  block: BlockOf<'serviceAreasBlock'>
  'data-sanity'?: string
}

const { block, 'data-sanity': dataSanity } = Astro.props
const items = (block.items ?? []).filter(Boolean)
const cols = Math.min(Math.max(items.length, 2), 3)
---

<Section anchorId={block.anchorId} background={block.background} data-sanity={dataSanity}>
  <SectionHeader heading={block.heading} intro={block.intro} align="center" />
  <div class={`grid-cards grid-cards--${cols}`} style={cols === 2 ? "max-width:52rem;margin-inline:auto" : undefined}>
    {items.map((area, i) => <ProgramCard item={{ ...area, ageRange: area.driveTime }} index={i + 1} />)}
  </div>
</Section>
