---
import type { BlockOf } from '@cms/lib/types'
import Section from '@components/ui/Section.astro'
import SectionHeader from '@components/ui/SectionHeader.astro'
import SanityImage from '@components/ui/SanityImage.astro'
import Icon from '@components/ui/Icon.astro'

interface Props {
  block: BlockOf<'teamBlock'>
  'data-sanity'?: string
}

const { block, 'data-sanity': dataSanity } = Astro.props
const items = (block.items ?? []).filter(Boolean)
const accents = ['coral', 'sky', 'sage', 'sunshine']
---

<Section anchorId={block.anchorId} background={block.background} data-sanity={dataSanity}>
  <SectionHeader heading={block.heading} intro={block.intro} align="center" />
  <div class="team-grid">
    {
      items.map((m, i) => (
        <article class="team-card card">
          {m.photo?.asset && (
            <div class={`shape shape--arch accent-${accents[i % accents.length]}`}>
              <SanityImage image={m.photo} width={480} aspectRatio={4 / 5} sizes="(min-width: 900px) 320px, 80vw" />
            </div>
          )}
          <div class="team-card__body">
            <h3>{m.name}</h3>
            {m.role && <p class="team-card__role">{m.role}</p>}
            {m.bio && <p>{m.bio}</p>}
            {m.credentials?.length ? (
              <ul class="chip-row">
                {m.credentials.map((c) => (
                  <li class="chip">
                    <Icon name="shield" /> {c}
                  </li>
                ))}
              </ul>
            ) : null}
          </div>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .team-grid { display: grid; gap: 1.5rem; max-width: 60rem; margin-inline: auto; }
  .team-card { display: grid; gap: 1.5rem; padding: 1.5rem; align-items: center; }
  .team-card .shape { max-width: 280px; width: 100%; justify-self: center; }
  .team-card h3 { font-size: 1.6rem; }
  .team-card__role { font-weight: 700; color: var(--coral-700); margin: 0.2rem 0 0.7rem; }
  .team-card__body > p + p { color: var(--fg2); }
  .team-card .chip-row { list-style: none; margin-top: 1rem; }
  @media (min-width: 760px) {
    .team-card { grid-template-columns: 260px 1fr; padding: 2rem; gap: 2.25rem; }
  }
</style>
