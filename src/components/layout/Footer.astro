---
import { stegaClean } from '@sanity/client/stega'
import type { Layout } from '@cms/lib/types'
import { hrefFor } from '@cms/routes'
import { resolveLink, telHref } from '@cms/lib/links'
import { urlFor } from '@cms/lib/image'
import SocialIcon from '@components/ui/SocialIcon.astro'
import Icon from '@components/ui/Icon.astro'

interface Props {
  layout: Layout
}

const { settings, navigation, programs, homeServices, cities, footerPages } = Astro.props.layout
const year = new Date().getFullYear()
const siteName = stegaClean(settings?.siteName) || 'Uriah Child Care'
const copyright = settings?.copyrightName || settings?.siteName
const logoSrc = settings?.logoInverse?.asset
  ? urlFor(settings.logoInverse as Parameters<typeof urlFor>[0]).width(440).url()
  : '/brand/uriah-logo-white.svg'
const address = settings?.address
const mapsHref =
  stegaClean(settings?.gbpUrl) ||
  stegaClean(settings?.mapUrl) ||
  (address?.street ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${siteName}, ${address.street}, ${address.city}, ${address.state} ${address.zip}`)}` : undefined)
const fullAddress = address?.street ? `${address.street}, ${address.city}, ${address.state} ${address.zip}` : ''
const mapQuery = encodeURIComponent(`${siteName}, ${stegaClean(fullAddress)}`)
const mapEmbed = stegaClean(settings?.gbpMapEmbedUrl) || `https://maps.google.com/maps?q=${mapQuery}&z=15&output=embed`
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${mapQuery}`
const label = (p: { shortTitle?: string | null; title?: string | null }) => p.shortTitle || p.title
const aboutLinks = [
  { href: '/about-ms-paulette/', label: 'Meet Ms. Paulette' },
  { href: '/our-center/', label: 'Our center' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/tuition/', label: 'Tuition' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/tour/', label: 'Book a tour' },
]
---

<footer class="site-footer">
  <div class="site-footer__wave" aria-hidden="true">
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none"><path d="M0 30c120 20 240 30 360 20S600 0 720 10s240 40 360 40 240-20 360-30v40H0Z" /></svg>
  </div>
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a href="/"><img src={logoSrc} alt={`${siteName} home`} width="200" height="114" loading="lazy" /></a>

      {/* NAP block: identical to the Google Business Profile */}
      <address class="site-footer__nap">
        <strong>{siteName}</strong>
        {
          address?.street && (
            <a href={mapsHref} target="_blank" rel="noopener noreferrer">
              <Icon name="pin" size={18} />
              <span>{fullAddress}</span>
            </a>
          )
        }
        {
          settings?.phone && (
            <a href={telHref(settings.phone)} data-track="call_click">
              <Icon name="phone" size={18} />
              <span>{settings.phone}</span>
            </a>
          )
        }
        {
          settings?.email && (
            <a href={`mailto:${stegaClean(settings.email)}`}>
              <Icon name="mail" size={18} />
              <span>{settings.email}</span>
            </a>
          )
        }
        {
          settings?.hoursSummary && (
            <span>
              <Icon name="clock" size={18} />
              <span>{settings.hoursSummary}</span>
            </span>
          )
        }
      </address>

      {
        settings?.socialLinks?.length ? (
          <ul class="site-footer__social">
            {settings.socialLinks.map((social) => (
              <li>
                <a href={stegaClean(social.url) ?? '#'} target="_blank" rel="noopener noreferrer" aria-label={stegaClean(social.platform) ?? 'Social profile'}>
                  <SocialIcon platform={social.platform} />
                </a>
              </li>
            ))}
          </ul>
        ) : null
      }
    </div>

    <nav class="site-footer__col" aria-label="Programs">
      <h2>Programs</h2>
      <ul>
        {
          programs?.map((p) => (
            <li>
              <a href={hrefFor(p._type, p.slug) ?? '#'}>{label(p)}</a>
            </li>
          ))
        }
        {
          homeServices?.map((p) => (
            <li>
              <a href={hrefFor(p._type, p.slug) ?? '#'}>{label(p)}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      navigation?.footerColumns?.length ? (
        navigation.footerColumns.map((col) => (
          <nav class="site-footer__col" aria-label={col.heading ?? 'Links'}>
            <h2>{col.heading}</h2>
            <ul>
              {col.links?.map((l) => {
                const link = resolveLink(l.link)
                return link ? (
                  <li>
                    <a href={link.href} target={link.target} rel={link.rel}>
                      {l.label}
                    </a>
                  </li>
                ) : null
              })}
            </ul>
          </nav>
        ))
      ) : (
        <nav class="site-footer__col" aria-label="About us">
          <h2>Get to know us</h2>
          <ul>
            {aboutLinks.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="site-footer__map">
      <h2>Find us</h2>
      <div class="site-footer__map-frame">
        <iframe
          src={mapEmbed}
          title={`Map: ${siteName}, ${stegaClean(fullAddress)}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        />
      </div>
      <p class="site-footer__areas">
        Serving <a href="/">Vineland</a>{
          cities?.map((c, i) => (
            <>
              {i === (cities?.length ?? 0) - 1 ? ' and ' : ', '}
              <a href={hrefFor(c._type, c.slug) ?? '#'}>{c.city}</a>
            </>
          ))
        }
      </p>
      <a class="site-footer__directions" href={directionsHref} target="_blank" rel="noopener noreferrer" data-track="directions_click">
        <Icon name="directions" size={18} /> Get directions
      </a>
    </div>
  </div>

  <div class="container">
    <ul class="site-footer__facts">
      {settings?.license?.summary && <li><Icon name="shield" size={16} /> {settings.license.summary}</li>}
      {settings?.subsidyStatement && <li><Icon name="wallet" size={16} /> {settings.subsidyStatement}</li>}
      {settings?.foodProgramStatement && <li><Icon name="utensils" size={16} /> {settings.foodProgramStatement}</li>}
    </ul>
  </div>

  <div class="site-footer__bottom">
    <div class="container site-footer__bottom-inner">
      <p>© {year} {copyright}. All rights reserved.</p>
      {
        footerPages?.length ? (
          <ul>
            {footerPages.map((p) => (
              <li>
                <a href={hrefFor('page', p.slug) ?? '#'}>{p.title}</a>
              </li>
            ))}
          </ul>
        ) : null
      }
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: calc(var(--section-y) * 0.9);
    background: var(--navy);
    color: rgba(255, 255, 255, 0.86);
    padding-top: 3.75rem;
  }
  .site-footer__wave {
    position: absolute;
    top: -39px;
    left: 0;
    right: 0;
    height: 40px;
    line-height: 0;
  }
  .site-footer__wave svg { width: 100%; height: 100%; fill: var(--navy); }
  .site-footer__grid { display: grid; gap: 2.5rem; }
  .site-footer__brand img { height: 80px; width: auto; }
  .site-footer__nap { display: grid; gap: 0.6rem; margin-top: 1.5rem; font-style: normal; }
  .site-footer__nap strong { font-family: var(--font-display); font-size: 1.15rem; color: #fff; }
  .site-footer__nap a, .site-footer__nap > span { display: inline-flex; align-items: flex-start; gap: 0.6rem; }
  .site-footer__nap :global(svg) { flex: none; margin-top: 0.2rem; color: var(--sunshine); }
  .site-footer__social { list-style: none; display: flex; gap: 0.5rem; margin-top: 1.25rem; }
  .site-footer__social a { display: inline-grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: rgba(255, 255, 255, 0.1); }
  .site-footer h2 { font-size: 1.1rem; color: #fff; margin-bottom: 1rem; }
  .site-footer__col ul { list-style: none; display: grid; gap: 0.55rem; }
  .site-footer a { transition: color 180ms var(--ease-out); }
  .site-footer__grid a:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }

  .site-footer__map-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--navy-600);
  }
  .site-footer__map-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .site-footer__areas { margin-top: 0.9rem; font-size: 0.95rem; }
  .site-footer__areas a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(255, 255, 255, 0.35); }
  .site-footer__directions {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--sunshine);
  }
  .site-footer__directions :global(svg) { flex: none; }

  /* Small print: smaller than the links, in a row on desktop and stacked on phones. */
  .site-footer__facts {
    list-style: none;
    display: grid;
    gap: 0.5rem;
    margin-top: 2.75rem;
    padding-top: 1.75rem;
    padding-bottom: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 0.82rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.7);
  }
  .site-footer__facts li { display: flex; gap: 0.45rem; align-items: flex-start; }
  .site-footer__facts :global(svg) { flex: none; margin-top: 0.1rem; color: var(--sunshine); opacity: 0.85; }

  .site-footer__bottom { background: var(--navy-600); padding-block: 1.1rem; font-size: 0.82rem; color: rgba(255, 255, 255, 0.72); }
  .site-footer__bottom-inner { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.6rem 1.5rem; }
  .site-footer__bottom ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; }
  .site-footer__bottom a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(255, 255, 255, 0.3); }
  .site-footer__bottom a:hover { color: #fff; }

  @media (min-width: 768px) {
    .site-footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .site-footer__facts { display: flex; flex-wrap: wrap; justify-content: flex-start; gap: 0.5rem 2rem; }
  }
  @media (min-width: 1040px) {
    .site-footer__facts { flex-wrap: nowrap; justify-content: space-between; }
    .site-footer__grid { grid-template-columns: 1.2fr 0.9fr 0.9fr 1.3fr; gap: 3rem; }
  }
</style>
