---
interface Props {
  settings: any
  nav: any
}

const { settings, nav } = Astro.props
const year = new Date().getFullYear()
const copyrightName = settings?.copyrightName ?? settings?.siteName ?? 'Company'

const socials = [
  { key: 'facebook',  label: 'Facebook',  url: settings?.facebook },
  { key: 'instagram', label: 'Instagram', url: settings?.instagram },
  { key: 'linkedin',  label: 'LinkedIn',  url: settings?.linkedin },
  { key: 'youtube',   label: 'YouTube',   url: settings?.youtube },
].filter((s) => s.url)
---

<footer class="footer">
  <div class="container footer-inner">

    <!-- Brand Column -->
    <div class="footer-brand">
      <a href="/" class="footer-logo-link" aria-label="Home">
        {settings?.siteName && <span class="footer-site-name">{settings.siteName}</span>}
      </a>
      {settings?.footerTagline && (
        <p class="footer-tagline">{settings.footerTagline}</p>
      )}

      <!-- Social Links -->
      {socials.length > 0 && (
        <div class="footer-socials">
          {socials.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-social-link"
              aria-label={s.label}
            >
              {s.label}
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Nav Links Column -->
    {nav?.links?.length > 0 && (
      <div class="footer-nav">
        <p class="footer-col-heading">Navigation</p>
        {nav.links.map((link: any) => (
          <a href={link.href} class="footer-link">{link.label}</a>
        ))}
      </div>
    )}

    <!-- Contact Column -->
    {(settings?.email || settings?.phone || settings?.address) && (
      <div class="footer-contact">
        <p class="footer-col-heading">Contact</p>
        {settings?.phone && (
          <a href={`tel:${settings.phone}`} class="footer-link">{settings.phone}</a>
        )}
        {settings?.email && (
          <a href={`mailto:${settings.email}`} class="footer-link">{settings.email}</a>
        )}
        {settings?.address && (
          <p class="footer-link footer-address">{settings.address}</p>
        )}
        {settings?.serviceArea && (
          <p class="footer-service-area">Serving {settings.serviceArea}</p>
        )}
      </div>
    )}
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="footer-copyright">
        &copy; {year} {copyrightName}. All rights reserved.
      </p>
      <div class="footer-legal">
        <a href="/privacy-policy" class="footer-legal-link">Privacy Policy</a>
        <a href="/terms"          class="footer-legal-link">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-dark);
    color: var(--color-text-inverse);
    margin-top: auto;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-block: 4rem;
  }

  @media (min-width: 640px) {
    .footer-inner { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .footer-inner { grid-template-columns: 2fr 1fr 1fr; }
  }

  .footer-site-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-inverse);
  }

  .footer-tagline {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    color: #94a3b8;
    max-width: 28ch;
    line-height: 1.6;
  }

  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .footer-social-link {
    font-size: 0.875rem;
    color: #94a3b8;
    transition: color 0.15s;
  }

  .footer-social-link:hover { color: var(--color-text-inverse); }

  .footer-col-heading {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #64748b;
    margin-bottom: 1rem;
  }

  .footer-link {
    display: block;
    font-size: 0.9375rem;
    color: #94a3b8;
    margin-bottom: 0.5rem;
    transition: color 0.15s;
    text-decoration: none;
  }

  .footer-link:hover { color: var(--color-text-inverse); }

  .footer-address { white-space: pre-line; }

  .footer-service-area {
    font-size: 0.8125rem;
    color: #64748b;
    margin-top: 0.75rem;
  }

  /* Bottom bar */
  .footer-bottom {
    border-top: 1px solid #1e293b;
    padding-block: 1.25rem;
  }

  .footer-bottom-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  @media (min-width: 640px) {
    .footer-bottom-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-copyright {
    font-size: 0.875rem;
    color: #64748b;
  }

  .footer-legal {
    display: flex;
    gap: 1.5rem;
  }

  .footer-legal-link {
    font-size: 0.875rem;
    color: #64748b;
    transition: color 0.15s;
  }

  .footer-legal-link:hover { color: #94a3b8; }
</style>
