---
import SanityImage, { type SanityImageValue } from '@components/ui/SanityImage.astro'

interface Props {
  title: string | null
  eyebrow?: string | null
  intro?: string | null
  image?: SanityImageValue | null
}

/** Navy page hero for detail pages (news posts), matching the inner-page heroes. */
const { title, eyebrow, intro, image } = Astro.props
---

<header class="section page-hero detail-header">
  <div class="container detail-header__inner">
    <div class="detail-header__text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="page-title">{title}</h1>
      {intro && <p class="detail-header__intro">{intro}</p>}
    </div>
    {image?.asset && (
      <div class="detail-header__media">
        <SanityImage image={image} width={720} aspectRatio={4 / 3} loading="eager" fetchpriority="high" />
      </div>
    )}
  </div>
</header>

<style>
  .detail-header { padding-top: clamp(1.75rem, 4vw, 3rem); }
  .detail-header__inner { display: grid; gap: 2.5rem; align-items: center; }
  .detail-header__text { min-width: 0; }
  .detail-header h1 { margin-top: 0.6rem; font-size: clamp(2rem, 4.4vw, 3.1rem); line-height: 1.1; }
  .detail-header__intro { margin-top: 1.1rem; font-size: 1.12rem; max-width: 40rem; }
  .detail-header__media :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-2xl); box-shadow: 0 24px 50px -28px rgb(0 0 0 / 0.55); }
  @media (min-width: 880px) { .detail-header__inner { grid-template-columns: 3fr 2fr; gap: 3.5rem; } }
  :global(.detail-body) { max-width: 44rem; margin-inline: auto; }
</style>
