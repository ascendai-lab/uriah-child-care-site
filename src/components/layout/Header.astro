---
import { stegaClean } from '@sanity/client/stega'
import type { Layout } from '@cms/lib/types'
import { resolveLink, telHref } from '@cms/lib/links'
import { editAttr } from '@cms/lib/visualEditing'
import { urlFor } from '@cms/lib/image'
import Button from '@components/ui/Button.astro'
import Icon, { type IconName } from '@components/ui/Icon.astro'
import SanityImage from '@components/ui/SanityImage.astro'

interface Props {
  layout: Layout
}

const { layout } = Astro.props
const { settings, navigation } = layout
const { draftMode } = Astro.locals
const norm = (href: string) => href.replace(/\/+$/, '') || '/'
const currentPath = norm(Astro.url.pathname)
const announcement = settings?.announcement
const announcementLink = resolveLink(announcement?.link)
const isCurrent = (href: string | undefined) => href !== undefined && norm(href) === currentPath
const siteName = stegaClean(settings?.siteName) || 'Uriah Child Care'
const logoSrc = settings?.logo?.asset ? urlFor(settings.logo as Parameters<typeof urlFor>[0]).width(440).url() : '/brand/uriah-logo.svg'
const phone = settings?.phone
const tourHref = resolveLink(navigation?.headerCta?.link)?.href ?? '/tour/'
---

{
  announcement?.enabled && announcement.text && (
    <div class="announcement">
      {announcementLink ? (
        <a href={announcementLink.href} target={announcementLink.target} rel={announcementLink.rel}>
          {announcement.text}
        </a>
      ) : (
        <span>{announcement.text}</span>
      )}
    </div>
  )
}

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo">
      <img src={logoSrc} alt={`${siteName} home`} width="200" height="114" />
    </a>

    <nav aria-label="Main" class="site-nav" id="site-nav" data-sanity={editAttr(draftMode, { _id: 'navigation', _type: 'navigation' }, 'headerLinks')}>
      <ul class="site-nav__list">
        {
          navigation?.headerLinks?.map((item, index) => {
            const link = resolveLink(item.link)
            const children = item.children?.filter((child) => resolveLink(child.link)) ?? []
            if (children.length) {
              const open = children.some((c) => isCurrent(resolveLink(c.link)?.href)) || isCurrent(link?.href)
              return (
                <li class="site-nav__item" style={`--i:${index}`}>
                  <details class="site-nav__dropdown">
                    <summary class:list={[open && 'is-active']}>
                      {item.label}
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="m6 9 6 6 6-6" />
                      </svg>
                    </summary>
                    <div class="mega">
                      <div class="mega__inner">
                        <ul class="mega__links">
                          {children.map((child) => {
                            const childLink = resolveLink(child.link)!
                            const icon = (stegaClean(child.icon) || 'sparkle') as IconName
                            return (
                              <li>
                                <a
                                  class="mega__link"
                                  href={childLink.href}
                                  target={childLink.target}
                                  rel={childLink.rel}
                                  aria-current={isCurrent(childLink.href) ? 'page' : undefined}
                                >
                                  <span class="mega__icon"><Icon name={icon} size={20} /></span>
                                  <span class="mega__text">
                                    <span class="mega__label">{child.label}</span>
                                    {child.description && <span class="mega__desc">{child.description}</span>}
                                  </span>
                                </a>
                              </li>
                            )
                          })}
                          {link && (
                            <li class="mega__all">
                              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                                See all {String(stegaClean(item.label)).toLowerCase()} <Icon name="arrow" size={16} />
                              </a>
                            </li>
                          )}
                        </ul>
                        <aside class="mega__feature">
                          {item.menuPhoto?.asset && (
                            <SanityImage image={item.menuPhoto} width={520} aspectRatio={16 / 10} sizes="320px" class="mega__photo" />
                          )}
                          <p class="mega__note">{item.menuNote || 'See the center for yourself. Tours take about 20 minutes.'}</p>
                          <a class="btn btn--primary mega__cta" href={tourHref}>
                            Book a tour
                          </a>
                        </aside>
                      </div>
                    </div>
                  </details>
                </li>
              )
            }
            return (
              <li class="site-nav__item" style={`--i:${index}`}>
                {link ? (
                  <a href={link.href} target={link.target} rel={link.rel} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                ) : (
                  <span>{item.label}</span>
                )}
              </li>
            )
          })
        }
      </ul>
      {
        phone && (
          <a class="site-nav__phone-mobile phone-link" href={telHref(phone)} data-track="call_click" style={`--i:${navigation?.headerLinks?.length ?? 0}`}>
            <span class="phone-link__icon"><Icon name="phone" /></span>
            <span>{phone}<small>Call us today</small></span>
          </a>
        )
      }
    </nav>

    <div class="site-header__actions">
      {
        phone && (
          <a class="site-header__phone" href={telHref(phone)} data-track="call_click" aria-label={`Call ${siteName} at ${stegaClean(phone)}`}>
            <span class="site-header__phone-icon"><Icon name="phone" size={18} /></span>
            <span class="site-header__phone-text">{phone}</span>
          </a>
        )
      }
      {navigation?.headerCta?.label ? <Button button={navigation.headerCta} /> : <a class="btn btn--primary" href="/tour/">Book a tour</a>}
      <button class="site-header__toggle" aria-controls="site-nav" aria-expanded="false" aria-label="Open menu">
        <span class="toggle-open"><Icon name="menu" size={24} /></span>
        <span class="toggle-close"><Icon name="close" size={24} /></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')
  const toggle = document.querySelector<HTMLButtonElement>('.site-header__toggle')
  const nav = document.getElementById('site-nav')
  const desktop = window.matchMedia('(min-width: 1080px)')

  // The mobile menu is a full-screen panel that starts right under the header and covers the page.
  const placeMenu = () => header && nav?.style.setProperty('--nav-top', `${Math.max(0, header.getBoundingClientRect().bottom)}px`)
  const setMenu = (open: boolean) => {
    if (!toggle || !nav) return
    if (open) placeMenu()
    toggle.setAttribute('aria-expanded', String(open))
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu')
    nav.classList.toggle('is-open', open)
    document.documentElement.classList.toggle('menu-open', open)
  }
  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'))
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('is-open')) {
      setMenu(false)
      toggle?.focus()
    }
  })
  // Following a link (including #anchors on the same page) closes the menu.
  nav?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a') && !desktop.matches) setMenu(false)
  })
  desktop.addEventListener('change', () => setMenu(false))
  window.addEventListener('resize', () => nav?.classList.contains('is-open') && placeMenu())

  // Close other dropdowns when one opens, and when clicking outside.
  const dropdowns = Array.from(document.querySelectorAll<HTMLDetailsElement>('.site-nav__dropdown'))
  dropdowns.forEach((d) =>
    d.addEventListener('toggle', () => {
      if (d.open) dropdowns.filter((o) => o !== d).forEach((o) => (o.open = false))
    }),
  )
  document.addEventListener('click', (e) => {
    if (window.matchMedia('(min-width: 1080px)').matches && !(e.target as Element).closest('.site-nav__dropdown')) {
      dropdowns.forEach((d) => (d.open = false))
    }
  })

  // Desktop: the mega menu also opens on hover (with a short delay so it doesn't flicker when the
  // mouse passes over), and Escape closes it and returns focus to its button.
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)')
  dropdowns.forEach((d) => {
    let timer: number | undefined
    const later = (open: boolean, ms: number) => {
      window.clearTimeout(timer)
      timer = window.setTimeout(() => (d.open = open), ms)
    }
    d.addEventListener('mouseenter', () => desktop.matches && canHover.matches && later(true, 90))
    d.addEventListener('mouseleave', () => desktop.matches && canHover.matches && later(false, 220))
  })
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !desktop.matches) return
    const open = dropdowns.find((d) => d.open)
    if (open) {
      open.open = false
      open.querySelector('summary')?.focus()
    }
  })
</script>

<style>
  .announcement {
    background: var(--navy);
    color: #fff;
    text-align: center;
    font-size: 0.92rem;
    font-weight: 600;
    padding: 0.55rem 1rem;
  }
  .announcement a { text-decoration: underline; text-underline-offset: 3px; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--cream);
    border-bottom: 1px solid var(--border-hairline);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 76px;
  }
  .site-header__logo img { height: 56px; width: auto; }
  .site-header__actions { display: flex; align-items: center; gap: 0.6rem; }
  .site-header__actions .btn { min-height: 44px; padding: 0.55rem 1.15rem; font-size: 0.98rem; }

  .site-header__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .site-header__phone-icon {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--sunshine);
  }
  .site-header__phone-text { display: none; }

  /* Mobile menu: a full-screen panel over the page. It unrolls from the header,
     then the items slide down one after another. */
  .site-nav {
    position: fixed;
    inset: var(--nav-top, 76px) 0 0 0;
    z-index: 49;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--cream);
    padding: 1.25rem var(--container-px) 2.5rem;
    visibility: hidden;
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.5s;
  }
  .site-nav.is-open {
    visibility: visible;
    clip-path: inset(0 0 0 0);
    transition:
      clip-path 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s;
  }
  .site-nav__item,
  .site-nav__phone-mobile {
    opacity: 0;
    transform: translateY(-14px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .site-nav.is-open .site-nav__item,
  .site-nav.is-open .site-nav__phone-mobile {
    opacity: 1;
    transform: none;
    transition: opacity 0.45s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(0.12s + var(--i, 0) * 0.06s);
  }
  :global(html.menu-open body) { overflow: hidden; }
  @media (prefers-reduced-motion: reduce) {
    .site-nav, .site-nav.is-open { clip-path: none; opacity: 0; transition: opacity 0.15s, visibility 0s linear 0.15s; }
    .site-nav.is-open { opacity: 1; transition: opacity 0.15s, visibility 0s; }
    .site-nav__item, .site-nav__phone-mobile,
    .site-nav.is-open .site-nav__item, .site-nav.is-open .site-nav__phone-mobile { opacity: 1; transform: none; transition: none; }
  }
  .site-nav__list { list-style: none; display: grid; gap: 0.1rem; }
  .site-nav__item > a,
  .site-nav__item summary,
  .site-nav__item > span {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.95rem 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.3rem;
    cursor: pointer;
  }
  .site-nav a[aria-current='page'], .site-nav summary.is-active { color: var(--coral-700); }
  .site-nav__dropdown summary { list-style: none; }
  .site-nav__dropdown summary::-webkit-details-marker { display: none; }
  .site-nav__dropdown[open] summary svg { transform: rotate(180deg); }
  /* Dropdown content. On phones it's a simple indented list; on desktop it becomes the mega menu. */
  .mega__links { list-style: none; padding: 0 0 0.5rem 0.9rem; }
  .mega__link, .mega__all a { display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 0; font-weight: 600; font-size: 1.05rem; }
  .mega__link:hover, .mega__all a:hover { color: var(--coral-700); }
  .mega__icon { display: none; }
  .mega__desc, .mega__feature { display: none; }
  .mega__all a { color: var(--coral-800); }
  .site-nav__phone-mobile { margin-top: 1.5rem; }
  .site-nav__list > .site-nav__item + .site-nav__item { border-top: 1px solid var(--border-hairline); }

  .site-header__toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--white);
    border: 1px solid var(--border-default);
    border-radius: 50%;
    cursor: pointer;
    color: inherit;
  }
  .toggle-close { display: none; }
  .site-header__toggle[aria-expanded='true'] .toggle-open { display: none; }
  .site-header__toggle[aria-expanded='true'] .toggle-close { display: block; }
  .toggle-open, .toggle-close { line-height: 0; }

  @media (max-width: 420px) {
    .site-header__logo img { height: 46px; }
    .site-header__actions .btn { padding-inline: 0.9rem; font-size: 0.92rem; }
    .site-header__phone-icon { width: 2.3rem; height: 2.3rem; }
  }

  @media (min-width: 1080px) {
    .site-header__toggle, .site-nav__phone-mobile { display: none; }
    .site-header__phone-text { display: inline; }
    .site-header__phone-icon { width: 2.2rem; height: 2.2rem; }
    .site-nav, .site-nav.is-open {
      position: static;
      padding: 0;
      background: none;
      overflow: visible;
      visibility: visible;
      clip-path: none;
      transition: none;
    }
    .site-nav__item, .site-nav.is-open .site-nav__item { opacity: 1; transform: none; transition: none; }
    .site-nav__list > .site-nav__item + .site-nav__item { border-top: 0; }
    .site-nav__list { display: flex; gap: 1.4rem; }
    .site-nav__item > a, .site-nav__item summary { padding: 0.5rem 0; font-size: 1.02rem; }
    /* Mega menu: a wide panel that drops from under the header, centred on the page. */
    .mega {
      position: absolute;
      top: 100%;
      left: 50%;
      width: min(1080px, calc(100vw - 2 * var(--container-px)));
      transform: translate(-50%, 6px);
      padding-top: 0.75rem;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.22s ease, transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 0.28s;
    }
    .site-nav__dropdown[open] .mega {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0);
      transition: opacity 0.22s ease, transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s;
    }
    .mega__inner {
      display: grid;
      grid-template-columns: 1fr 300px;
      gap: 1.5rem;
      padding: 1.5rem;
      background: var(--white);
      border: 1px solid var(--border-hairline);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-overlay);
    }
    .mega__links {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-content: start;
      gap: 0.25rem 1rem;
      padding: 0;
    }
    .mega__link {
      align-items: flex-start;
      gap: 0.85rem;
      padding: 0.8rem 0.85rem;
      border-radius: var(--radius-lg);
      font-size: 1rem;
      transition: background-color 0.18s ease;
    }
    .mega__link:hover, .mega__link:focus-visible { background: var(--cream); color: inherit; }
    .mega__link[aria-current='page'] .mega__label { color: var(--coral-700); }
    .mega__icon {
      display: inline-grid;
      place-items: center;
      flex: none;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 50%;
      background: var(--sunshine-50);
      color: var(--coral-800);
      transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .mega__link:hover .mega__icon { transform: scale(1.08) rotate(-6deg); }
    .mega__text { display: grid; gap: 0.15rem; }
    .mega__label { font-family: var(--font-display); font-weight: 600; font-size: 1.02rem; }
    .mega__desc { display: block; font-family: var(--font-body); font-weight: 400; font-size: 0.88rem; line-height: 1.45; color: var(--color-text-muted); }
    .mega__all { grid-column: 1 / -1; padding: 0.4rem 0.85rem 0; }
    .mega__all a { display: inline-flex; gap: 0.35rem; padding: 0.4rem 0; font-family: var(--font-display); font-size: 0.98rem; }
    .mega__all a :global(svg) { transition: transform 0.2s ease; }
    .mega__all a:hover :global(svg) { transform: translateX(3px); }
    .mega__feature {
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
      padding: 0.85rem 0.85rem 1.1rem;
      background: var(--cream);
      border-radius: var(--radius-lg);
    }
    .mega__feature :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius-md); }
    .mega__note { font-size: 0.95rem; line-height: 1.5; padding-inline: 0.15rem; }
    .mega__cta { align-self: flex-start; }
    @media (prefers-reduced-motion: reduce) {
      .mega, .site-nav__dropdown[open] .mega { transition: none; transform: translate(-50%, 0); }
    }
  }
</style>
