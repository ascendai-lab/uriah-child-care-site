---
import type { Layout } from '@cms/lib/types'
import SanityImage from '@components/ui/SanityImage.astro'
import Doodle from '@components/ui/Doodle.astro'
import Icon from '@components/ui/Icon.astro'
import TourForm from '@components/ui/TourForm'

interface Props {
  layout: Layout
  heading?: string | null
  intro?: string | null
  /** Rendered as the page's main form (on /tour/), not the shared footer block. */
  asPageForm?: boolean
  id?: string
}

const { layout, heading, intro, asPageForm = false, id = 'book-a-tour' } = Astro.props
// The same form closes every page, so its band changes color from page to page (Mark, 2026-11-04):
// logo green on the home page, then blue, yellow and green in turn, so pages next to each other in the
// menu never share a color. Pages not listed get a color from their address.
const tones = ['sky', 'sunshine', 'sage'] as const
const order = [
  'early-learning-vineland-nj', 'child-care-vineland-nj', 'after-school-program-vineland-nj', 'toddler-care-vineland-nj',
  'kindergarten-readiness-vineland-nj', 'play-based-learning-vineland-nj', 'potty-training-daycare-vineland-nj',
  'first-shift-child-care-vineland-nj', 'evening-child-care-vineland-nj', 'late-evening-child-care-vineland-nj',
  'saturday-daycare-vineland-nj', 'child-care-for-shift-workers-vineland-nj', 'full-time-part-time-daycare-vineland-nj',
  'before-school-care-vineland-nj', 'homework-help-vineland-nj', 'summer-child-care-vineland-nj', 'school-closure-care-vineland-nj',
  'ccap-child-care-vineland-nj', 'daycare-meals-vineland-nj', 'safe-licensed-daycare-vineland-nj', 'millville-nj', 'bridgeton-nj',
  'about-ms-paulette', 'our-center', 'reviews', 'faq', 'tuition', 'tour', 'news',
]
const path = Astro.url.pathname
const first = path.split('/').filter(Boolean)[0] ?? ''
const at = order.indexOf(first)
const tone =
  path === '/' ? 'forest' : tones[at >= 0 ? at % tones.length : [...path].reduce((n, c) => (n * 31 + c.charCodeAt(0)) % 9973, 7) % tones.length]
const owner = layout.owner
const phone = layout.settings?.phone
const reassurance = [
  { icon: 'clock', text: 'Tours take about 20 minutes' },
  { icon: 'heart', text: 'Bring your questions, and your little one' },
  { icon: 'phone', text: "We'll call you within one business day" },
] as const
---

<section class:list={['section tour-block', `tour-block--${tone}`, asPageForm && 'tour-block--page']} id={id} aria-labelledby={`${id}-heading`}>
  <div class="container">
    <div class="tour-block__card">
      <Doodle type="sun" color={tone === 'sunshine' ? 'coral' : 'sunshine'} size={60} class="doodle--float doodle--slow tour-block__doodle" style="top:-22px;right:8%" />
      <div class="tour-block__aside">
        <h2 id={`${id}-heading`} class="section-heading">{heading ?? 'Come see our Vineland center'}</h2>
        <p class="section-intro">
          {intro ?? 'Tell us a little about your family and Ms. Paulette will call you to pick a time that works for you.'}
        </p>
        <ul class="tour-block__reassure">
          {
            reassurance.map((r) => (
              <li>
                <span class="tour-block__reassure-icon"><Icon name={r.icon} size={18} /></span>
                {r.text}
              </li>
            ))
          }
        </ul>
        {
          owner?.photo?.asset && (
            <figure class="tour-block__owner">
              <div class="shape shape--circle accent-sky">
                <SanityImage image={owner.photo} width={180} aspectRatio={1} sizes="120px" />
              </div>
              <figcaption>
                <strong>{owner.name}</strong>
                <span>{owner.role}</span>
              </figcaption>
            </figure>
          )
        }
      </div>
      <div class="tour-block__form card">
        <TourForm client:visible phone={phone} idPrefix={id} />
      </div>
    </div>
  </div>
</section>

<style>
  .tour-block { padding-top: calc(var(--section-y) * 0.6); padding-bottom: 0; }
  .tour-block--page { padding-top: 2rem; }
  .tour-block__card {
    position: relative;
    display: grid;
    gap: 2rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: var(--radius-2xl);
    background: var(--tour-bg);
    color: var(--tour-fg);
  }
  /* Deep logo green and blue carry white text; the yellow band keeps navy text (all pass WCAG AA). */
  /* Home only: the deepest logo green, so the home page's band is its own. */
  .tour-block--forest { --tour-bg: #2c5e55; --tour-fg: #fff; --tour-soft: #fff; }
  .tour-block--sage { --tour-bg: var(--sage-700); --tour-fg: #fff; --tour-soft: #fff; }
  .tour-block--sky { --tour-bg: var(--sky-700); --tour-fg: #fff; --tour-soft: rgba(255, 255, 255, 0.84); }
  .tour-block--sunshine { --tour-bg: var(--sunshine); --tour-fg: var(--navy); --tour-soft: var(--navy); }
  .tour-block__card :global(.section-intro) { color: var(--tour-soft); }
  .tour-block__owner span { color: var(--tour-soft) !important; }
  .tour-block__form { color: var(--fg1); }
  .tour-block__form { padding: clamp(1.25rem, 3vw, 2rem); }
  .tour-block__reassure { list-style: none; display: grid; gap: 0.6rem; margin-top: 1.5rem; }
  .tour-block__reassure li { display: flex; align-items: center; gap: 0.7rem; font-weight: 600; }
  .tour-block__reassure-icon {
    display: inline-grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--white);
    color: var(--navy);
    flex: none;
  }
  .tour-block__owner { display: flex; align-items: center; gap: 1rem; margin-top: 2rem; }
  .tour-block__owner .shape { width: 104px; flex: none; }
  .tour-block__owner figcaption { display: grid; }
  .tour-block__owner strong { font-family: var(--font-display); font-size: 1.15rem; }
  .tour-block__owner span { color: var(--fg2); font-size: 0.92rem; }
  @media (max-width: 640px) {
    /* Phones: no card around the card, so the form gets the full width. */
    .tour-block__card { padding: 1.5rem 1rem 1rem; border-radius: var(--radius-xl); gap: 1.5rem; }
    .tour-block__form { box-shadow: none; }
    .tour-block__owner { display: none; }
    :global(.tour-block__doodle) { display: none; }
  }
  @media (min-width: 960px) {
    .tour-block__card { grid-template-columns: 5fr 7fr; align-items: start; gap: 3rem; }
    /* The intro column stays beside the taller form while you fill it in. */
    .tour-block__card > :first-child { position: sticky; top: 7rem; }
  }
</style>
