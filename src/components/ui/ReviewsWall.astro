---
import { stegaClean } from '@sanity/client/stega'
import type { SiteSettings } from '@cms/lib/types'
import ReviewCard from '@components/cards/ReviewCard.astro'
import Icon from '@components/ui/Icon.astro'

type Review = Parameters<typeof ReviewCard>[0]['review'] & { _id?: string }

interface Props {
  reviews: (Review | null | undefined)[] | null | undefined
  settings?: SiteSettings | null
  /** Show the "Leave a review" link next to "View more reviews". */
  showWrite?: boolean
}

/** The same Google reviews on every page: a 3-column masonry wall plus a link to the full list on Google. */
const { reviews, settings, showWrite = true } = Astro.props
const items = (reviews ?? []).filter((r): r is Review => Boolean(r))
const moreUrl = stegaClean(settings?.gbpReviewUrl) || stegaClean(settings?.gbpUrl)
const writeUrl = stegaClean(settings?.gbpWriteReviewUrl)

// Masonry without layout jumps: deal the reviews into 3 columns, each going to the shortest column
// so far (by an estimate of its height). On phones and tablets the columns fold into one simple grid.
const COLUMNS = 3
const CARD_OVERHEAD = 220
// Phones show the first few reviews only, so the section doesn't run thousands of pixels.
const MOBILE_COUNT = 99
type Slot = { review: Review; index: number }
const columns: { items: Slot[]; height: number }[] = Array.from({ length: COLUMNS }, () => ({ items: [], height: 0 }))
// The invite tile always closes the last column, so count its height there before dealing the reviews.
if (showWrite && writeUrl) columns[COLUMNS - 1].height = 380
items.forEach((review, index) => {
  const shortest = columns.reduce((a, b) => (b.height < a.height ? b : a))
  shortest.items.push({ review, index })
  shortest.height += Math.min(stegaClean(review.quote)?.length ?? 0, 420) + CARD_OVERHEAD
})
// With fewer reviews than slots, the shortest column gets an invitation to leave one, so the wall stays even.
const inviteColumn = showWrite && writeUrl ? columns[COLUMNS - 1] : null
---

{
  items.length ? (
    <>
      <div class="reviews-grid">
        {columns.map((col) => (
          <div class="reviews-grid__col">
            {col.items.map(({ review, index }) => (
              <div class:list={['reviews-grid__item', index >= MOBILE_COUNT && 'reviews-grid__item--extra']} style={`order:${index}`}>
                <ReviewCard review={review} />
              </div>
            ))}
            {col === inviteColumn && (
              <div class="reviews-invite" style={`order:${items.length}`}>
                <p class="reviews-invite__title">Is your family part of Uriah Child Care Center?</p>
                <p>A few words on Google help other Vineland parents find safe, caring child care.</p>
                <a class="text-link" href={writeUrl} target="_blank" rel="noopener noreferrer">Leave a Google review</a>
              </div>
            )}
          </div>
        ))}
      </div>
      {moreUrl && (
        <div class="reviews-actions">
          <a class="btn btn--secondary" href={moreUrl} target="_blank" rel="noopener noreferrer">
            View more reviews on Google <span class="btn__arrow" aria-hidden="true"><Icon name="arrow" /></span>
          </a>
        </div>
      )}
    </>
  ) : null
}

<style>
  .reviews-grid { display: grid; gap: 1.25rem; align-items: start; }
  .reviews-grid__col { display: contents; }
  .reviews-invite {
    display: grid;
    gap: 0.5rem;
    padding: 1.6rem;
    border-radius: var(--radius-lg);
    background: var(--sunshine-50);
  }
  .reviews-invite__title { font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; color: var(--navy); }
  .reviews-invite p:not(.reviews-invite__title) { color: var(--fg2); }
  .reviews-invite .text-link { justify-self: start; padding-block: 0.3rem; }
  .reviews-actions { display: flex; justify-content: center; margin-top: 2.25rem; }
  @media (max-width: 1039px) {
    .reviews-grid__item--extra { display: none; }
  }
  @media (min-width: 720px) { .reviews-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1040px) {
    .reviews-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .reviews-grid__col { display: grid; gap: 1.25rem; align-content: start; }
    .reviews-grid__col > * { order: 0 !important; }
  }
</style>
