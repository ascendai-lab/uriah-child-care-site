---
import { stegaClean } from '@sanity/client/stega'
import { resolveLink, type LinkValue } from '@cms/lib/links'
import Icon from './Icon.astro'

interface Props {
  button: { label?: string | null; variant?: string | null; link?: LinkValue | null } | null | undefined
  size?: 'md' | 'lg'
  /** Show the round arrow badge. Defaults to on for primary buttons. */
  arrow?: boolean
}

const { button, size = 'md', arrow } = Astro.props
const link = resolveLink(button?.link)
const variant = stegaClean(button?.variant) || 'primary'
const showArrow = arrow ?? (variant === 'primary' && size === 'lg')
const isTel = link?.href.startsWith('tel:')
---

{
  button?.label && link && (
    <a
      href={link.href}
      target={link.target}
      rel={link.rel}
      class:list={['btn', `btn--${variant}`, size === 'lg' && 'btn--lg']}
      data-track={isTel ? 'call_click' : undefined}
    >
      {button.label}
      {showArrow && (
        <span class="btn__arrow" aria-hidden="true">
          <Icon name="arrow" />
        </span>
      )}
    </a>
  )
}
