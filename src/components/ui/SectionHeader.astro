---
interface Props {
  heading?: string | null
  intro?: string | null
  as?: 'h1' | 'h2'
  align?: 'left' | 'center'
}

const { heading, intro, as: Tag = 'h2', align = 'left' } = Astro.props
---

{
  (heading || intro) && (
    <header class:list={['section-header', align === 'center' && 'section-header--center']}>
      {heading && <Tag class="section-heading">{heading}</Tag>}
      {intro && <p class="section-intro">{intro}</p>}
    </header>
  )
}
