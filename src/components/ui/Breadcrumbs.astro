---
export interface Crumb {
  label: string
  href: string
}
interface Props {
  items: Crumb[]
}
const { items } = Astro.props
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol role="list">
    {
      items.map((c, i) =>
        i === items.length - 1 ? (
          <li><a href={c.href} aria-current="page">{c.label}</a></li>
        ) : (
          <li>
            <a href={c.href}>{c.label}</a>
          </li>
        ),
      )
    }
  </ol>
</nav>
