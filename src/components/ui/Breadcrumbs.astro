---
export interface Crumb {
  label: string
  href: string
}
interface Props {
  items: Crumb[]
}
const { items } = Astro.props
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {
      items.map((c, i) =>
        i === items.length - 1 ? (
          <li aria-current="page">{c.label}</li>
        ) : (
          <li>
            <a href={c.href}>{c.label}</a>
          </li>
        ),
      )
    }
  </ol>
</nav>
