---
/** Hand-drawn style accents from the design references (sun, star, heart, squiggle, cloud). Decorative only. */
interface Props {
  type: 'sun' | 'star' | 'heart' | 'squiggle' | 'cloud' | 'sparkles' | 'loop'
  color?: 'coral' | 'sage' | 'sunshine' | 'sky' | 'navy' | 'white'
  size?: number
  style?: string
  class?: string
}

const { type, color = 'sunshine', size = 56, style, class: className } = Astro.props
const stroke = `var(--${color === 'white' ? 'white' : color})`

const art: Record<Props['type'], string> = {
  sun: `<circle cx="32" cy="32" r="11" fill="${stroke}"/><g stroke="${stroke}" stroke-width="4" stroke-linecap="round"><path d="M32 5v8M32 51v8M5 32h8M51 32h8M13 13l5.5 5.5M45.5 45.5 51 51M13 51l5.5-5.5M45.5 18.5 51 13"/></g>`,
  star: `<path d="M32 6c2 13 6 18 20 20-14 3-18 7-20 22-2-15-6-19-20-22 14-2 18-7 20-20Z" fill="${stroke}"/>`,
  heart: `<path d="M32 54S8 40 8 23c0-8 6-13 12.5-13 5 0 9 3 11.5 7 2.5-4 6.5-7 11.5-7C50 10 56 15 56 23c0 17-24 31-24 31Z" fill="${stroke}"/>`,
  squiggle: `<path d="M4 36c6-12 12-12 18 0s12 12 18 0 12-12 18 0" fill="none" stroke="${stroke}" stroke-width="5" stroke-linecap="round"/>`,
  cloud: `<path d="M18 46h30a11 11 0 0 0 1-22 15 15 0 0 0-29-3A12 12 0 0 0 18 46Z" fill="${stroke}"/>`,
  sparkles: `<path d="M22 8c1.5 9 4 12 13 13.5-9 1.5-11.5 4.5-13 13.5-1.5-9-4-12-13-13.5C18 20 20.5 17 22 8Z" fill="${stroke}"/><path d="M46 32c1 6 3 8 9 9-6 1-8 3-9 9-1-6-3-8-9-9 6-1 8-3 9-9Z" fill="${stroke}"/>`,
  loop: `<path d="M6 44c10 2 18-4 20-12 2-9-8-12-10-4-2 9 10 14 20 10 8-3 14-12 22-12" fill="none" stroke="${stroke}" stroke-width="4" stroke-linecap="round"/>`,
}
---

<span class:list={['doodle', className]} style={`width:${size}px;height:${size}px;${style ?? ''}`} aria-hidden="true">
  <svg viewBox="0 0 64 64" set:html={art[type]} />
</span>
