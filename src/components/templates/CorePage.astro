---
/**
 * One template for every "Core 30" page: program hubs (GBP categories), services and city pages.
 * The structure is fixed on purpose so every page gets the same SEO signals:
 * answer-first intro, quick facts, body copy with editorial links, a tour link after the
 * second section, reviews that mention the service, visible FAQs (+ FAQPage schema),
 * related links, a "last updated" date and the shared tour block.
 */
import { stegaClean } from '@sanity/client/stega'
import type { Layout, RouteDoc } from '@cms/lib/types'
import { hrefFor } from '@cms/routes'
import { telHref } from '@cms/lib/links'
import { formatDate } from '@/lib/format'
import PortableText from '@components/ui/PortableText'
import SanityImage from '@components/ui/SanityImage.astro'
import ProgramCard from '@components/cards/ProgramCard.astro'
import ReviewsWall from '@components/ui/ReviewsWall.astro'
import FaqList from '@components/ui/FaqList.astro'
import Icon from '@components/ui/Icon.astro'
import PhoneLink from '@components/ui/PhoneLink.astro'
import PageBuilder from '@components/blocks/PageBuilder.astro'

interface Props {
  doc: RouteDoc
  layout: Layout
}

const { doc, layout } = Astro.props
const settings = layout.settings
const accent = stegaClean(doc.accent) || 'coral'
const a = settings?.address
const where = a?.street ? `${a.street}, ${a.city}` : 'Vineland, NJ'
const label = (p: { shortTitle?: string | null; title?: string | null }) => p.shortTitle || p.title

const eyebrow =
  doc._type === 'serviceArea'
    ? `For ${stegaClean(doc.city)} families`
    : doc.parent
      ? label(doc.parent)
      : doc._type === 'category'
        ? 'Programs in Vineland'
        : 'Uriah Child Care · Vineland, NJ'

const related = [
  ...(doc.parent ? [doc.parent] : []),
  ...(doc.siblings ?? []),
  ...(doc.related ?? []),
].filter((p, i, list) => p && list.findIndex((q) => q?._id === p._id) === i && p._id !== doc._id)

const services = (doc.services ?? []).filter(Boolean)
// Same reviews on every page (Mark, 2026-11-04), not page-specific pairs.
const reviews = (layout.reviews ?? []).filter(Boolean)

// A page with only one or two questions of its own is topped up with general questions from the FAQ,
// skipping any whose topic the page already answers.
const MIN_FAQS = 4
const TOPICS: [RegExp, RegExp][] = [
  [/hour|open|close|early|time|sunday|weekend/i, /^faq-(hours|third-shift)$/],
  [/age|youngest|old/i, /^faq-ages$/],
  [/ccap|subsid/i, /^faq-ccap$/],
  [/cost|price|tuition|pay/i, /^faq-cost$/],
  [/meal|lunch|dinner|snack|food/i, /^faq-meals$/],
  [/licens/i, /^faq-license$/],
  [/tour/i, /^faq-tour$/],
  [/potty|diaper/i, /^faq-potty$/],
  [/where|far|drive|millville|bridgeton/i, /^faq-where$/],
  [/school.*(pick|bus|transport)|pick.*school/i, /^faq-school-transport$/],
]
const ownFaqs = (doc.faqs ?? []).filter(Boolean)
const covered = (id: string) =>
  TOPICS.some(([question, faqId]) => faqId.test(id) && ownFaqs.some((f) => question.test(stegaClean(f.question) ?? '')))
const extraFaqs =
  ownFaqs.length >= MIN_FAQS
    ? []
    : (layout.generalFaqs ?? []).filter((f) => f && !covered(f._id)).slice(0, MIN_FAQS + 1 - ownFaqs.length)
const faqs = [...ownFaqs, ...extraFaqs]
const shownServices = services.filter((s) => !s.needsConfirmation)
// Keep the hero facts on one line: only the first sentence of the schedule (the full text is in Quick facts).
const heroSchedule = (doc.schedule || settings?.hoursSummary || '').split(/\.\s/)[0].replace(/\.$/, '') || null

// City pages lead with the map (how far the center is) instead of a photo, so they don't look like program pages.
const isCity = doc._type === 'serviceArea'
const siteName = stegaClean(settings?.siteName) || 'Uriah Child Care'
const mapQuery = encodeURIComponent(`${siteName}, ${a?.street ?? ''}, ${a?.city ?? ''}, ${a?.state ?? ''} ${a?.zip ?? ''}`)
const mapEmbed = stegaClean(settings?.gbpMapEmbedUrl) || `https://maps.google.com/maps?q=${mapQuery}&z=11&output=embed`

// Program grid: pick a column count that leaves no lonely card on the last row.
const n = shownServices.length
const programCols = n % 4 === 0 ? 4 : n % 3 === 0 ? 3 : n <= 4 ? n : n % 2 === 0 ? 2 : 3
// Hide the age badge when every card would show the same one.
const sameAge = n > 1 && shownServices.every((s) => stegaClean(s.ageRange) === stegaClean(shownServices[0].ageRange))
const highlightCount = doc.highlights?.length ?? 0
const highlightCols = highlightCount % 3 === 0 ? 3 : highlightCount % 2 === 0 ? 2 : 3
---

<section class:list={['core-hero', `accent-${accent}`]}>
  <div class="container">
    <div class="core-hero__card">
      <div class="core-hero__text enter">
        <span class="eyebrow"><Icon name="sparkle" /> {eyebrow}</span>
        <h1 class="page-title">{doc.title}</h1>
        {doc.intro && <p class="core-hero__intro">{doc.intro}</p>}
        <ul class="fact-line core-hero__facts">
          <li><Icon name="users" /> {doc.ageRange || settings?.agesServed}</li>
          {heroSchedule && <li><Icon name="clock" /> {heroSchedule}</li>}
          <li><Icon name="pin" /> {where}</li>
        </ul>
        <div class="btn-row">
          <a class="btn btn--primary btn--lg" href="#book-a-tour">
            Book a tour <span class="btn__arrow" aria-hidden="true"><Icon name="arrow" /></span>
          </a>
          <PhoneLink phone={settings?.phone} />
        </div>
      </div>
      {
        isCity ? (
          <div class="core-hero__media core-hero__map">
            <iframe src={mapEmbed} title={`Map: ${siteName}, ${where}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" />
            {doc.driveTime && <p class="core-hero__map-note"><Icon name="directions" size={16} /> {doc.driveTime} from {stegaClean(doc.city)}</p>}
          </div>
        ) : doc.image?.asset && (
          <div class="core-hero__media">
            <div class="shape shape--arch">
              <SanityImage image={doc.image} width={560} aspectRatio={4 / 5} sizes="(min-width: 900px) 420px, 85vw" loading="eager" fetchpriority="high" />
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>

<section class="section bg-white core-body">
  <div class="container core-body__grid">
    <div class="core-body__main">
      <PortableText value={doc.body ?? []} />
    </div>

    <aside class="core-facts card" aria-label="Quick facts">
      <h2>Quick facts</h2>
      <dl>
        <div><dt><Icon name="users" /> Ages</dt><dd>{doc.ageRange || settings?.agesServed}</dd></div>
        <div><dt><Icon name="clock" /> Days and times</dt><dd>{doc.schedule || settings?.hoursSummary}</dd></div>
        {a?.street && <div><dt><Icon name="pin" /> Where</dt><dd>{a.street}, {a.city}, {a.state} {a.zip}</dd></div>}
        {doc.driveTime && <div><dt><Icon name="directions" /> Drive</dt><dd>{doc.driveTime}</dd></div>}
        {settings?.subsidyStatement && <div><dt><Icon name="wallet" /> Subsidy</dt><dd>{settings.subsidyStatement} <a class="text-link" href="/ccap-child-care-vineland-nj/">How CCAP works</a></dd></div>}
        {settings?.license?.summary && <div><dt><Icon name="shield" /> License</dt><dd>{settings.license.summary}</dd></div>}
      </dl>
      <a class="btn btn--secondary" href="#book-a-tour">Book a tour</a>
      {settings?.phone && <a class="core-facts__call" href={telHref(settings.phone)} data-track="call_click">or call {settings.phone}</a>}
    </aside>
  </div>
</section>

{
  doc.highlights?.length ? (
    <section class="section bg-white">
      <div class="container">
        <h2 class="section-heading core-section-title">What your family gets</h2>
        <ul class="checklist core-highlights" style={`--cols:${highlightCols}`}>
          {doc.highlights.map((h) => (
            <li>
              <span class="checklist__icon"><Icon name="check" /></span>
              <span>{h}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ) : null
}

{
  doc.dayPlan?.length ? (
    <section class="section bg-muted">
      <div class="container">
        <h2 class="section-heading core-section-title">What the day looks like</h2>
        <ol class:list={["day-plan", `day-plan--${doc.dayPlan.length % 3 === 0 ? 3 : 4}`]}>
          {doc.dayPlan.map((step, i) => (
            <li class={`accent-${['coral', 'sage', 'sunshine', 'sky'][i % 4]}`}>
              <span class="day-plan__when">{step.label}</span>
              <span class="day-plan__what">{step.activity}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>
  ) : null
}

{
  shownServices.length ? (
    <section class="section bg-white">
      <div class="container">
        <header class="section-header section-header--center">
          <h2 class="section-heading">{doc._type === 'category' ? 'Choose the care that fits' : 'More programs at our Vineland center'}</h2>
        </header>
        <div class={`grid-cards grid-cards--${programCols}`}>
          {shownServices.map((s, i) => <ProgramCard item={s} index={i} hideAge={sameAge} />)}
        </div>
      </div>
    </section>
  ) : null
}

{
  reviews.length ? (
    <section class="section bg-muted">
      <div class="container">
        <header class="section-header section-header--center">
          <h2 class="section-heading">What parents say</h2>
          <p class="section-intro">Real reviews from local families on Google.</p>
        </header>
        <ReviewsWall reviews={reviews} settings={settings} />
      </div>
    </section>
  ) : null
}

{
  faqs.length ? (
    <section class="section bg-white">
      <div class="container core-faq">
        <h2 class="section-heading core-section-title">Questions parents ask</h2>
        <FaqList items={faqs} openFirst />
      </div>
    </section>
  ) : null
}

<PageBuilder blocks={doc.pageBuilder} document={doc} layout={layout} firstHeroIsH1={false} />

{
  related.length ? (
    <section class="section section--tight bg-white">
      <div class="container">
        <nav class="keep-exploring" aria-label="Related pages">
          <h2>Keep exploring</h2>
          <ul>
            {related.map((p) => (
              <li>
                <a href={hrefFor(p._type, p.slug) ?? '#'}>
                  {label(p)} <Icon name="arrow" size={16} />
                </a>
              </li>
            ))}
            <li>
              <a href="/">Day care center in Vineland <Icon name="arrow" size={16} /></a>
            </li>
          </ul>
        </nav>
        {doc.lastReviewed && <p class="last-updated">Last updated {formatDate(doc.lastReviewed)}</p>}
      </div>
    </section>
  ) : (
    doc.lastReviewed && (
      <div class="container">
        <p class="last-updated">Last updated {formatDate(doc.lastReviewed)}</p>
      </div>
    )
  )
}

<style>
  .core-hero { padding-block: 1.5rem clamp(1rem, 3vw, 2.5rem); }
  .core-hero__card {
    position: relative;
    display: grid;
    gap: 2.25rem;
    align-items: center;
  }
  .core-hero__map { max-width: 440px; }
  .core-hero__map iframe {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    border: 0;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    background: var(--surface-soft);
  }
  .core-hero__map-note { display: flex; align-items: center; gap: 0.45rem; margin-top: 0.8rem; font-weight: 600; color: var(--fg2); }
  .core-hero__map-note :global(svg) { color: var(--coral-700); }
  .core-hero__intro { font-size: 1.15rem; margin-top: 1rem; max-width: 38rem; }
  .core-hero__facts { margin-top: 1.5rem; }
  .core-hero__media { position: relative; max-width: 380px; width: 100%; justify-self: center; }

  .core-body__grid { display: grid; gap: 2.5rem; align-items: start; }
  .core-body__main > :global(.prose:first-child > :first-child) { margin-top: 0; }
  .core-facts { padding: 1.5rem; display: grid; gap: 1rem; }
  .core-facts h2 { font-size: 1.35rem; }
  .core-facts dl { display: grid; gap: 0.9rem; }
  .core-facts dt { display: flex; align-items: center; gap: 0.45rem; font-family: var(--font-display); font-weight: 600; }
  .core-facts dt :global(svg) { color: var(--coral-700); }
  .core-facts dd { color: var(--fg2); margin-top: 0.15rem; font-size: 0.97rem; }
  .core-facts__call { text-align: center; font-weight: 700; font-size: 0.95rem; text-decoration: underline; text-underline-offset: 3px; }

  .core-section-title { margin-bottom: 1.75rem; }
  .core-highlights { grid-template-columns: 1fr; }
  @media (min-width: 720px) { .core-highlights { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1040px) { .core-highlights { grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); } }
  .core-highlights li { border-radius: var(--radius-lg); }

  .day-plan { list-style: none; display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); counter-reset: step; }
  @media (min-width: 900px) { .day-plan--3 { grid-template-columns: repeat(3, 1fr); } .day-plan--4 { grid-template-columns: repeat(4, 1fr); } }
  .day-plan li {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding: 1.2rem 1.3rem;
    border-radius: var(--radius-xl);
    background: var(--white);
    box-shadow: var(--shadow-card);
  }
  .day-plan__when {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.12rem;
    color: var(--navy);
  }
  .day-plan__when::before {
    content: '';
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }
  .day-plan__what { color: var(--fg2); }

  .core-faq { max-width: 52rem; }

  .keep-exploring h2 { font-size: 1.35rem; margin-bottom: 1rem; }
  .keep-exploring ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .keep-exploring a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.1rem;
    border-radius: var(--radius-full);
    background: var(--white);
    border: 1.5px solid var(--border-default);
    font-weight: 700;
    transition: border-color 200ms var(--ease-out), transform 200ms var(--ease-out);
  }
  .keep-exploring a:hover { border-color: var(--navy); transform: translateY(-1px); }
  .last-updated { margin-top: 1.5rem; font-size: 0.88rem; color: var(--fg3); }

  @media (min-width: 900px) {
    .core-hero__card { grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.75fr); gap: 3rem; }
    .core-body__grid { grid-template-columns: minmax(0, 1fr) 320px; gap: 3.5rem; }
    .core-facts { position: sticky; top: 100px; }
  }
</style>
