---
interface Props {
  headline: string
  subheadline?: string
  image?: { asset?: { url: string } }
  primaryCta?: { label: string; href: string; openInNewTab?: boolean }
  secondaryCta?: { label: string; href: string; openInNewTab?: boolean }
}

const { headline, subheadline, image, primaryCta, secondaryCta } = Astro.props
---

<section class="hero section">
  <div class="container hero-inner">

    <!-- Text Content -->
    <div class="hero-content">
      <h1 class="hero-headline">{headline}</h1>

      {subheadline && (
        <p class="hero-subheadline">{subheadline}</p>
      )}

      <div class="hero-actions">
        {primaryCta && (
          <a
            href={primaryCta.href}
            class="btn btn--primary btn--lg"
            target={primaryCta.openInNewTab ? '_blank' : undefined}
            rel={primaryCta.openInNewTab ? 'noopener noreferrer' : undefined}
          >
            {primaryCta.label}
          </a>
        )}
        {secondaryCta && (
          <a
            href={secondaryCta.href}
            class="btn btn--outline btn--lg"
            target={secondaryCta.openInNewTab ? '_blank' : undefined}
            rel={secondaryCta.openInNewTab ? 'noopener noreferrer' : undefined}
          >
            {secondaryCta.label}
          </a>
        )}
      </div>
    </div>

    <!-- Hero Image -->
    {image?.asset?.url && (
      <div class="hero-image-wrap">
        <img
          src={image.asset.url}
          alt={headline}
          class="hero-image"
          width="640"
          height="480"
          loading="eager"
        />
      </div>
    )}
  </div>
</section>

<style>
  .hero { background: var(--color-bg-muted); }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero-inner { grid-template-columns: 1fr 1fr; }
  }

  .hero-headline {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .hero-subheadline {
    margin-top: 1.25rem;
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--color-text-muted);
    max-width: 50ch;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-image-wrap {
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.15);
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Button variants */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
    text-decoration: none;
    white-space: nowrap;
  }

  .btn--lg { padding: 0.75rem 1.75rem; font-size: 1rem; }

  .btn--primary {
    background: var(--color-brand);
    color: #fff;
  }
  .btn--primary:hover { background: var(--color-brand-hover); }

  .btn--outline {
    background: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-border-strong);
  }
  .btn--outline:hover {
    background: var(--color-bg);
    border-color: var(--color-text);
  }
</style>
