---
interface Service {
  icon?: string
  title: string
  description: string
}

interface Props {
  heading?: string
  subheading?: string
  services?: Service[]
}

const { heading, subheading, services = [] } = Astro.props
---

{services.length > 0 && (
  <section class="services section">
    <div class="container">

      {(heading || subheading) && (
        <div class="services-header">
          {heading    && <h2 class="services-heading">{heading}</h2>}
          {subheading && <p class="services-subheading">{subheading}</p>}
        </div>
      )}

      <div class="services-grid">
        {services.map((service) => (
          <div class="service-card">
            {service.icon && (
              <div class="service-icon" aria-hidden="true">
                {/* Icon name from Lucide — Claude Code will swap this for the actual icon component */}
                <span class="service-icon-placeholder">{service.icon}</span>
              </div>
            )}
            <h3 class="service-title">{service.title}</h3>
            <p class="service-description">{service.description}</p>
          </div>
        ))}
      </div>

    </div>
  </section>
)}

<style>
  .services { background: var(--color-bg); }

  .services-header {
    text-align: center;
    max-width: 56ch;
    margin-inline: auto;
    margin-bottom: 3.5rem;
  }

  .services-heading {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--color-text);
  }

  .services-subheading {
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .services-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .service-card {
    padding: 2rem;
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    background: var(--color-bg-muted);
    transition: box-shadow 0.2s, border-color 0.2s;
  }

  .service-card:hover {
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
    border-color: var(--color-border-strong);
  }

  .service-icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    background: var(--color-brand);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .service-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .service-description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
</style>
