---
interface Props {
  heading?: string
  body?: string
  button?: { label: string; href: string; openInNewTab?: boolean }
}

const { heading, body, button } = Astro.props
---

{heading && (
  <section class="cta-banner section">
    <div class="container cta-inner">
      <div class="cta-text">
        <h2 class="cta-heading">{heading}</h2>
        {body && <p class="cta-body">{body}</p>}
      </div>
      {button && (
        <a
          href={button.href}
          class="cta-btn"
          target={button.openInNewTab ? '_blank' : undefined}
          rel={button.openInNewTab ? 'noopener noreferrer' : undefined}
        >
          {button.label}
        </a>
      )}
    </div>
  </section>
)}

<style>
  .cta-banner {
    background: var(--color-brand);
    color: #fff;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .cta-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .cta-heading {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: #fff;
    max-width: 40ch;
  }

  .cta-body {
    margin-top: 0.5rem;
    font-size: 1rem;
    color: rgba(255,255,255,0.8);
    max-width: 48ch;
    line-height: 1.6;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    padding: 0.875rem 2rem;
    border-radius: var(--radius-md);
    background: #fff;
    color: var(--color-brand);
    font-weight: 700;
    font-size: 1rem;
    transition: opacity 0.15s;
    text-decoration: none;
    flex-shrink: 0;
  }

  .cta-btn:hover { opacity: 0.9; }
</style>
