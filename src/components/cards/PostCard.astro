---
import { routes } from '@cms/routes'
import SanityImage from '@components/ui/SanityImage.astro'
import { formatDate } from '@/lib/format'

interface Props {
  post: {
    title: string | null
    excerpt: string | null
    slug: string | null
    publishedAt: string | null
    image: Parameters<typeof SanityImage>[0]['image']
  }
}

const { post } = Astro.props
---

<article class="card post-card">
  {post.image?.asset && <SanityImage image={post.image} width={480} aspectRatio={16 / 9} />}
  <div class="post-card__body">
    {post.publishedAt && <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>}
    <h3>{post.slug ? <a href={routes.blogPost(post.slug)} class="stretched">{post.title}</a> : post.title}</h3>
    {post.excerpt && <p>{post.excerpt}</p>}
  </div>
</article>

<style>
  .post-card { position: relative; overflow: hidden; background: var(--white); }
  .post-card h3 { font-size: 1.25rem; line-height: 1.25; }
  .post-card p { color: var(--fg2); }
  .post-card :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .post-card__body { padding: 1.5rem; display: grid; gap: 0.5rem; }
  time { font-size: 0.85rem; font-weight: 600; color: var(--coral-700, var(--fg2)); }
  .stretched::after { content: ''; position: absolute; inset: 0; }
</style>
