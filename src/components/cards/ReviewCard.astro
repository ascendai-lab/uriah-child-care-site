---
import { stegaClean } from '@sanity/client/stega'
import Stars from '@components/ui/Stars.astro'

interface Props {
  review: {
    name?: string | null
    context?: string | null
    quote?: string | null
    rating?: number | null
    source?: string | null
    reviewUrl?: string | null
  }
  /** Soft background color for the card (used on the review wall, which sits on white). */
  tint?: 'coral' | 'sage' | 'sunshine' | 'sky'
}

const { review, tint } = Astro.props
const quote = (review.quote ?? '').trim()
// Long reviews start cut to a few lines; a "Read more" button opens the full text in place.
const long = quote.length > 170
const quoteId = `q-${Math.random().toString(36).slice(2, 9)}`
const url = stegaClean(review.reviewUrl)
const name = stegaClean(review.name) ?? ''
const initial = name.trim().charAt(0).toUpperCase()
const tones = ['coral', 'sage', 'sunshine', 'sky']
const tone = tones[[...name].reduce((n, c) => n + c.charCodeAt(0), 0) % tones.length]
const source = review.source ?? 'Google'
---

<figure class:list={['card review-card', tint && `review-card--${tint}`]} data-clamp={long ? '' : undefined}>
  {review.rating ? <Stars rating={review.rating} /> : null}
  {quote ? (
    <>
      <blockquote id={quoteId}>{quote}</blockquote>
      {long && (
        <button type="button" class="review-card__more" aria-expanded="false" aria-controls={quoteId}>Read more</button>
      )}
    </>
  ) : (
    <p class="review-card__rating-only">Left a {review.rating ?? 5}-star rating on Google.</p>
  )}
  <figcaption class="review-card__by">
    <span class={`review-card__avatar accent-${tone}`} aria-hidden="true">{initial}</span>
    <span class="review-card__who">
      <cite>{review.name}</cite>
      <span class="review-card__source">
        {review.context ? `${review.context} · ` : ''}
        {url ? (
          <a href={url} target="_blank" rel="noopener noreferrer">{source} review</a>
        ) : (
          `${source} review`
        )}
      </span>
    </span>
  </figcaption>
</figure>
