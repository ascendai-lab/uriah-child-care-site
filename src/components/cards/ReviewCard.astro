---
import { stegaClean } from '@sanity/client/stega'
import Stars from '@components/ui/Stars.astro'

interface Props {
  review: {
    name?: string | null
    context?: string | null
    quote?: string | null
    rating?: number | null
    source?: string | null
    reviewUrl?: string | null
  }
  /** Long reviews are trimmed to this many characters, with a link to read the rest on Google. */
  maxLength?: number
}

const { review, maxLength = 420 } = Astro.props
const quote = review.quote ?? ''
const trimmed = quote.length > maxLength ? `${quote.slice(0, quote.lastIndexOf(' ', maxLength))}…` : quote
const url = stegaClean(review.reviewUrl)
const name = stegaClean(review.name) ?? ''
const initial = name.trim().charAt(0).toUpperCase()
const tones = ['coral', 'sage', 'sunshine', 'sky']
const tone = tones[[...name].reduce((n, c) => n + c.charCodeAt(0), 0) % tones.length]
const source = review.source ?? 'Google'
---

<figure class="card review-card">
  {review.rating ? <Stars rating={review.rating} /> : null}
  {trimmed ? (
    <blockquote>{trimmed}</blockquote>
  ) : (
    <p class="review-card__rating-only">Left a {review.rating ?? 5}-star rating on Google.</p>
  )}
  <figcaption class="review-card__by">
    <span class={`review-card__avatar accent-${tone}`} aria-hidden="true">{initial}</span>
    <span class="review-card__who">
      <cite>{review.name}</cite>
      <span class="review-card__source">
        {review.context ? `${review.context} · ` : ''}
        {url ? (
          <a href={url} target="_blank" rel="noopener noreferrer">{source} review</a>
        ) : (
          `${source} review`
        )}
      </span>
    </span>
  </figcaption>
</figure>
